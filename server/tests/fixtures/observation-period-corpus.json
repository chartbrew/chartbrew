    {
      "id": "open-month-partial-flow",
      "description": "An open August total must not be compared with complete July revenue.",
      "tags": ["open_month", "flow", "legacy_false_positive"],
      "now": "2026-08-09T05:00:00.000Z",
      "monitor": {
        "kind": "timeseries",
        "behavior": "flow",
        "comparisonPeriod": "month",
        "timezone": "Asia/Bangkok",
        "threshold": { "type": "relative", "value": 0.1 }
      },
      "input": {
        "snapshots": [
          {
            "periodStart": "2026-07-01T00:00:00.000Z",
            "periodEnd": "2026-08-01T00:00:00.000Z",
            "value": 120000,
            "completeness": 1,
            "coverage": "complete"
          },
          {
            "periodStart": "2026-08-01T00:00:00.000Z",
            "periodEnd": "2026-09-01T00:00:00.000Z",
            "value": 25000,
            "completeness": 1,
            "coverage": "partial"
          }
        ]
      },
      "legacy": { "expectedPublish": true },
      "expected": { "status": "waiting_for_period_close", "publish": false }
    },
