      },
      "layoutIntent": {
        "kind": "comparison",
        "priority": 10
      },
      "cdc": {
        "datasetTemplateId": "top_pages",
        "xAxis": "root.data.rows[].value",
        "yAxis": "root.data.rows[].pageviews",
        "yAxisOperation": "none",
        "legend": "Pageviews",
        "datasetColor": "rgba(66, 133, 244, 1)",
        "fillColor": "rgba(66, 133, 244, 0.14)",
        "fill": true
      }
    },
    {
      "id": "traffic-channels",
      "name": "Traffic channels",
      "description": "Visitors by channel, such as search, social or email.",
      "icon": "ChartBar",
      "type": "bar",
      "requiredDatasetIds": [
        "top_channels"
      ],
      "chart": {
        "displayLegend": false,
