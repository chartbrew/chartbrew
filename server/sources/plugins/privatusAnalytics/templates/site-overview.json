      "layoutIntent": {
        "kind": "comparison",
        "priority": 20
      },
      "cdc": {
        "datasetTemplateId": "top_channels",
        "xAxis": "root.data.rows[].value",
        "yAxis": "root.data.rows[].visitors",
        "yAxisOperation": "none",
        "legend": "Visitors",
        "datasetColor": "rgba(66, 133, 244, 1)",
        "fillColor": "rgba(66, 133, 244, 0.14)",
        "fill": true
      }
    },
    {
