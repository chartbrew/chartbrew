{
  "name": "client",
  "private": true,
  "version": "v5.3.1",
  "type": "module",
  "scripts": {
    "start": "echo n | cp -vipr ../.env .env | true && npm run prepareSettings && vite",
    "dev": "echo n | cp -vipr ../.env .env | true && npm run prepareSettings && vite",
    "build": "npm run prepareSettings && vite build",
    "lint": "oxlint",
    "test": "npm run test:visualization",
    "test:ai": "node --test src/containers/Ai/aiMessageUtils.test.js src/containers/Ai/chartPreviewState.test.js src/containers/Ai/chatScroll.test.js src/modules/workspaceAuditFormat.test.js",
    "test:onboarding": "node --test src/containers/Onboarding/onboardingState.test.js",
    "test:visualization": "node --test src/containers/Chart/components/barDataLabels.test.js src/containers/Chart/components/echartsTooltip.test.js src/containers/Chart/components/sharing/shareImageDefaults.test.js src/modules/visualization.test.js src/visualization/echartsRenderState.test.js src/visualization/presetRegistry.test.js src/visualization/responsiveLayout.test.js src/visualization/scaleEChartsDetails.test.js src/visualization/shareImageLayout.test.js",
    "test:data-api": "node --test src/containers/ApiKeys/apiKeyPresentation.test.js",
    "preview": "vite preview",
    "tailwind": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "prepareSettings": "echo n | cp -vipr src/config/settings.template.js src/config/settings.js | true"
  },
  "dependencies": {
