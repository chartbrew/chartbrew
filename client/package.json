{
  "name": "client",
  "private": true,
  "version": "v6.0.0",
  "type": "module",
  "scripts": {
    "start": "echo n | cp -vipr ../.env .env | true && npm run prepareSettings && vite",
    "dev": "echo n | cp -vipr ../.env .env | true && npm run prepareSettings && vite",
    "build": "npm run prepareSettings && vite build",
    "lint": "oxlint",
    "test": "npm run test:settings && npm run test:visualization && npm run test:dataset && npm run test:loading && npm run test:welcome",
    "test:settings": "node --test ../scripts/prepareClientSettings.test.js",
    "test:loading": "node --experimental-vm-modules --test src/containers/ProjectBoard/ProjectBoard.test.js",
    "test:dataset": "node --test src/containers/Dataset/querySuggestion.test.js",
    "test:ai": "node --experimental-vm-modules --test src/containers/Ai/AiComposer.test.js src/containers/Ai/activeConversation.test.js src/containers/Ai/aiAvailability.test.js src/containers/Ai/aiMessageUtils.test.js src/containers/Ai/chartPreviewState.test.js src/containers/Ai/chatScroll.test.js src/modules/workspaceAuditFormat.test.js",
    "test:welcome": "node --experimental-vm-modules --test src/containers/UserDashboard/components/chartbrewV6Welcome.test.js src/containers/UserDashboard/components/ChartbrewV6WelcomeModal.test.js",
    "test:onboarding": "node --test src/containers/Onboarding/onboardingState.test.js",
    "test:visualization": "node --test src/containers/AddChart/chartStudioState.test.js src/containers/Chart/components/barDataLabels.test.js src/containers/Chart/components/echartsTooltip.test.js src/containers/Chart/components/sharing/shareImageDefaults.test.js src/modules/visualization.test.js src/visualization/echartsRenderState.test.js src/visualization/mapWheelZoom.test.js src/visualization/presetRegistry.test.js src/visualization/responsiveLayout.test.js src/visualization/scaleEChartsDetails.test.js src/visualization/shareImageLayout.test.js",
    "test:data-api": "node --test src/containers/ApiKeys/apiKeyPresentation.test.js",
    "preview": "vite preview",
    "tailwind": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "prepareSettings": "node ../scripts/prepareClientSettings.js"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@internationalized/date": "^3.12.4",
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "echarts": "6.1.0",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "immutability-helper": "^3.1.1",
    "lodash": "^4.17.20",
    "moment": "^2.31.0",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.0.6",
    "prop-types": "^15.8.1",
    "raf": "^3.4.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-cookies": "^0.1.1",
    "react-date-range": "^1.1.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^11.4.2",
    "react-grid-layout": "^1.5.4",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.0.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.1",
    "react-refresh": "^0.14.0",
    "react-router": "^7.18.5",
    "react-use": "^17.4.0",
    "redux": "^5.0.1",
    "redux-first-history": "^5.1.1",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0",
    "remark-gfm": "^4.0.0",
    "socket.io-client": "^4.8.4",
    "styled-components": "^4.4.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "three": "0.186.0",
    "uuid": "^14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "oxlint": "^1.90.0",
