    "immutability-helper": "^3.1.1",
    "lodash": "^4.17.20",
    "moment": "^2.29.1",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.0.6",
    "node-sql-parser": "^5.2.0",
    "prop-types": "^15.8.1",
    "raf": "^3.4.1",
    "react": "^19.2.4",
    "react-cookies": "^0.1.1",
